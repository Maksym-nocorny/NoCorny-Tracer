<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.nocorny.tracer</string>
	<key>CFBundleName</key>
	<string>NoCorny Tracer</string>
	<key>CFBundleShortVersionString</key>
	<string>4.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nocorny.tracer.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nocornytracer</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>4.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>NoCorny Tracer needs access to your camera to show a floating face cam while recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NoCorny Tracer needs access to your microphone to record audio with your screen recordings.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>NoCorny Tracer needs screen recording access to capture your screen.</string>
	<!-- Sparkle. SUEnableAutomaticChecks MUST stay: without it Sparkle asks for
	     permission with a prompt this almost-never-active app cannot surface
	     (nonactivating panels), and the unanswered prompt silently disables BOTH
	     the manual "Check for Updates" click and all scheduled checks (the
	     4.0.0/4.1.0 dead-updates bug). SUAutomaticallyUpdate makes scheduled
	     checks download and stage silently — the "Relaunch to update" chip is
	     the only scheduled-update UI (4.2.0). User defaults override both keys,
	     so the drawer's Auto-updates toggle keeps working. Guarded by
	     InfoPlistSparkleKeysTests. -->
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/Maksym-nocorny/NoCorny-Tracer/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>/rTgsbxP0R+H+r4jls5rHpV5S2JltlI5k1hlIKJ0NSg=</string>
</dict>
</plist>
